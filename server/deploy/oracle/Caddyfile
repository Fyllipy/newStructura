__DOMAIN__ {
	encode gzip
	# Limite de corpo (o maior payload legitimo e o modelo estrutural enviado ao /compute/validate)
	request_body {
		max_size 10MB
	}
	# API (licenciamento, loja, area do cliente, webhook, admin) -> FastAPI. O resto e o SITE estatico.
	@api path /auth/* /license/* /compute/* /admin /admin/* /portal/* /shop/* /webhook/* /health /pubkey
	handle @api {
		reverse_proxy 127.0.0.1:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle {
		root * /opt/structura/site
		file_server
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com; connect-src 'self' https://api.stripe.com https://m.stripe.network; img-src 'self' data: https://*.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 20MB
			roll_keep 5
		}
	}
}
