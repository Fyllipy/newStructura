# Copie para .env e preencha com valores reais (gere com: python gen_keys.py --write)
DATABASE_URL=sqlite:///./dev.db
SERVER_SIGNING_SEED_B64=
CPF_ENC_KEY_B64=
CPF_HMAC_KEY_B64=
# Chave PUBLICA de release (assina manifestos). A privada fica so no CI/maquina de build.
RELEASE_PUBKEY_B64=
GATE_PASS_TTL_SECONDS=60
REDIS_URL=
MODEL_CACHE_TTL_SECONDS=86400
# Token 8 dias (> ciclo semanal de heartbeat); revogacao e imediata via DB
TOKEN_TTL_SECONDS=691200
DEVICE_STALE_DAYS=7
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
REQUIRE_2FA=true
TOTP_WINDOW=1
EQUILIBRIUM_REL_TOL=0.000001
EQUILIBRIUM_ABS_FLOOR=0.001
# --- Endurecimento (auditoria) ---
# true SOMENTE atras de proxy reverso proprio (nginx/Caddy/Cloudflare); com false o X-Forwarded-For e ignorado
TRUST_PROXY_HEADERS=false
# falhas de credencial permitidas por IP na janela (0 desliga); complementa o lockout por conta
AUTH_FAIL_LIMIT_PER_IP=30
AUTH_FAIL_WINDOW_SECONDS=300
